# AegisX — example environment configuration
# Copy to ~/.config/aegisx/aegisx.env (permanent install) or the project root
# (source run). Values here are applied only if not already set in the shell.

# --- Mode -------------------------------------------------------------------
# 1 = demonstration mode with clearly-labelled sample data (RFC 5737 ranges)
# 0 = live mode: query configured providers (requires API keys below)
AEGISX_DEMO_MODE=1

# --- Provider API keys (alternatively configure in Settings → Intelligence Sources)
# AbuseIPDB  (free): https://www.abuseipdb.com/account/api
#AEGISX_ABUSEIPDB_KEY=
# AlienVault OTX (free): https://otx.alienvault.com/settings/api
#AEGISX_OTX_KEY=
# VirusTotal (free): https://www.virustotal.com/gui/my-apikey
#AEGISX_VIRUSTOTAL_KEY=
# ThreatFox (free, optional): https://threatfox.abuse.ch/api/
#AEGISX_THREATFOX_KEY=

# --- GeoIP ------------------------------------------------------------------
# Path to a local MaxMind GeoLite2-City.mmdb database (free account required)
#AEGISX_GEOIP_DB=/opt/GeoLite2/GeoLite2-City.mmdb

# --- Behaviour --------------------------------------------------------------
AEGISX_LOG_LEVEL=INFO
AEGISX_CACHE_TTL_HOURS=6
AEGISX_ACTIVITY_DAYS=30
AEGISX_ANALYST_NAME=Security Researcher

# --- Advanced ---------------------------------------------------------------
# Override the database location (defaults to ~/.local/share/aegisx/aegisx.db)
#AEGISX_DB=
# Console logging for debugging
#AEGISX_CONSOLE_LOG=1
