/* ============================================================
   AegisX — light.qss  (base application stylesheet)
   White light theme with red cybersecurity accents.
   @tokens are substituted at load time by styles/__init__.py
   ============================================================ */

* {
    outline: none;
}

QWidget {
    background: @bg;
    color: @text;
    font-family: @font_family;
    font-size: 13px;
    selection-background-color: @primary_soft;
    selection-color: @primary_dark;
}

QLabel, QCheckBox, QRadioButton { background: transparent; }

QMainWindow, #RootSurface { background: @bg; }

QToolTip {
    background: @surface;
    color: @text;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 12px;
}

/* ---------------------------------------------------------- scrollbars -- */
QScrollBar:vertical {
    background: transparent; width: 10px; margin: 4px 3px;
}
QScrollBar::handle:vertical {
    background: #D4DCE6; border-radius: 5px; min-height: 40px;
}
QScrollBar::handle:vertical:hover { background: @text_muted; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal {
    background: transparent; height: 10px; margin: 3px 4px;
}
QScrollBar::handle:horizontal {
    background: #D4DCE6; border-radius: 5px; min-width: 40px;
}
QScrollBar::handle:horizontal:hover { background: @text_muted; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

QScrollArea { border: 0; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }

/* ------------------------------------------------------------- inputs -- */
QLineEdit, QTextEdit, QPlainTextEdit {
    background: @surface;
    border: 1.5px solid @border;
    border-radius: @radius_input;
    padding: 8px 12px;
    color: @text;
    font-size: 13px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus { border-color: @primary_light; }
QLineEdit:disabled, QTextEdit:disabled { background: @surface_alt; color: @text_muted; }

QLineEdit[errorState="true"] { border-color: @critical; background: @critical_soft; }

QComboBox {
    background: @surface;
    border: 1.5px solid @border;
    border-radius: @radius_input;
    padding: 7px 12px;
    color: @text;
    min-height: 18px;
}
QComboBox:hover { border-color: @border_strong; }
QComboBox:focus { border-color: @primary_light; }
QComboBox::drop-down { border: 0; width: 26px; }
QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid @text_secondary;
    margin-right: 10px;
}
QComboBox QAbstractItemView {
    background: @surface;
    border: 1px solid @border;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: @hover;
    selection-color: @primary_dark;
    outline: 0;
}

QSpinBox, QDoubleSpinBox {
    background: @surface; border: 1.5px solid @border; border-radius: @radius_input;
    padding: 6px 8px;
}

/* ------------------------------------------------------------ buttons -- */
QPushButton {
    background: @surface;
    color: @text;
    border: 1.5px solid @border;
    border-radius: @radius_button;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
}
QPushButton:hover { background: @surface_alt; border-color: @border_strong; }
QPushButton:pressed { background: @surface_alt; }
QPushButton:disabled { color: @text_muted; border-color: @divider; }

QPushButton#Primary {
    background: @primary; color: #FFFFFF; border: 1.5px solid @primary;
    font-weight: 650; padding: 8px 20px;
}
QPushButton#Primary:hover { background: @primary_light; border-color: @primary_light; }
QPushButton#Primary:pressed { background: @primary_dark; border-color: @primary_dark; }
QPushButton#Primary:disabled { background: #F3A6AB; border-color: #F3A6AB; color: #FFF; }

QPushButton#Danger {
    background: @surface; color: @critical; border: 1.5px solid @critical_soft;
}
QPushButton#Danger:hover { background: @critical_soft; border-color: @critical; }

QPushButton#Ghost {
    background: transparent; border: 1.5px solid transparent; color: @text_secondary;
}
QPushButton#Ghost:hover { background: @surface_alt; color: @text; }

QPushButton#FlatLink {
    background: transparent; border: 0; color: @primary; padding: 2px 4px;
    font-weight: 600;
}
QPushButton#FlatLink:hover { color: @primary_dark; }

QToolButton { background: transparent; border: 0; border-radius: 8px; padding: 4px; }

/* ------------------------------------------------------------ tables -- */
QTableWidget, QTableView {
    background: @surface;
    border: 0;
    gridline-color: @divider;
    alternate-background-color: @surface_alt;
}
QTableWidget::item, QTableView::item {
    padding: 6px 8px;
    border-bottom: 1px solid @divider;
}
QTableWidget::item:selected, QTableView::item:selected {
    background: @selected; color: @text;
}
QHeaderView {
    background: @surface; border: 0; border-bottom: 1px solid @border;
}
QHeaderView::section {
    background: @surface;
    color: @text_secondary;
    border: 0;
    border-bottom: 1.5px solid @border;
    padding: 9px 8px;
    font-size: 11px;
    font-weight: 700;
}
QTableCornerButton::section { background: @surface; border: 0; }

/* -------------------------------------------------------------- misc -- */
QProgressBar {
    background: #EDF0F5; border: 0; border-radius: 6px; min-height: 8px;
    text-align: center; color: transparent;
}
QProgressBar::chunk { background: @primary; border-radius: 6px; }

QMenu {
    background: @surface; border: 1px solid @border; border-radius: 10px;
    padding: 6px;
}
QMenu::item { padding: 7px 18px 7px 12px; border-radius: 6px; }
QMenu::item:selected { background: @hover; color: @primary_dark; }
QMenu::separator { height: 1px; background: @divider; margin: 5px 8px; }

QCheckBox { spacing: 9px; }
QCheckBox::indicator {
    width: 18px; height: 18px; border: 1.5px solid @border_strong;
    border-radius: 5px; background: @surface;
}
QCheckBox::indicator:hover { border-color: @primary_light; }
QCheckBox::indicator:checked {
    background: @primary; border-color: @primary;
    image: none;
}

QSplitter::handle { background: @divider; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }

QGroupBox {
    border: 1px solid @divider; border-radius: 12px;
    margin-top: 12px; padding: 14px 10px 10px 10px; font-weight: 600;
}
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 4px; color: @text_secondary; }

QListWidget {
    background: @surface; border: 0; border-radius: 10px;
}
QListWidget::item { padding: 8px 10px; border-radius: 6px; }
QListWidget::item:selected { background: @hover; color: @text; }

#TitleBar { background: @surface; border-bottom: 1px solid @border; }
#Sidebar  { background: @sidebar; border-right: 1px solid @border; }
#StatusStrip { background: @surface; border-top: 1px solid @border; }
